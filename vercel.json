{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/machete/acasa-v2.html"
    },
    {
      "source": "/info",
      "destination": "/info.html"
    },
    {
      "source": "/categorie",
      "destination": "/machete/categorie.html"
    },
    {
      "source": "/produs",
      "destination": "/machete/produs.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
